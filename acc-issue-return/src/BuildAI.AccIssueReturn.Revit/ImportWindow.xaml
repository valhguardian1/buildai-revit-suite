<Window x:Class="BuildAI.AccIssueReturn.Revit.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BuildAI ACC Issue Return" Width="1250" Height="760" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"><Image x:Name="BrandImage" Width="28" Height="28"/><TextBlock Text="BuildAI ACC Issue Return" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
      <TextBlock x:Name="ModeText" Margin="0,0,0,6" FontWeight="SemiBold" />
      <WrapPanel Margin="0,0,0,6"><TextBlock Text="Hub" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="HubBox" Width="210" SelectionChanged="HubChanged"/><TextBlock Text="Project" VerticalAlignment="Center" Margin="14,0,5,0"/><ComboBox x:Name="ProjectBox" Width="250" SelectionChanged="ProjectChanged"/><Button Content="Refresh" Click="RefreshClicked" Margin="12,0,0,0"/><Button Content="Cancel loading" Click="CancelClicked" Margin="6,0,0,0"/></WrapPanel>
      <WrapPanel Margin="0,0,0,6"><TextBlock Text="ACC models" VerticalAlignment="Top" Margin="0,4,5,0"/><ListBox x:Name="ModelList" Width="470" Height="74" SelectionMode="Extended"/><Button Content="Load Issues" Click="LoadIssuesClicked" Margin="10,18,0,0"/></WrapPanel>
      <WrapPanel Margin="0,0,0,6"><TextBlock Text="Assigned user" VerticalAlignment="Center" Margin="0,0,5,0"/><ComboBox x:Name="AssignedBox" Width="180" SelectionChanged="FilterChanged"/><TextBlock Text="Type" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="TypeBox" Width="150" SelectionChanged="FilterChanged"/><TextBlock Text="Model" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="IssueModelBox" Width="190" SelectionChanged="FilterChanged"/><TextBlock Text="Status" VerticalAlignment="Center" Margin="10,0,5,0"/><ComboBox x:Name="StatusBox" Width="140" SelectionChanged="FilterChanged"/><TextBox x:Name="SearchBox" Width="180" Margin="10,0,0,0" TextChanged="FilterChanged" ToolTip="Search title, description or issue id"/></WrapPanel>
      <WrapPanel Margin="0,0,0,6"><TextBlock Text="Section padding (m)" VerticalAlignment="Center"/><TextBox x:Name="PaddingBox" Text="1" Width="45" Margin="6,0,14,0"/><CheckBox x:Name="OpenOnSelectionBox" Content="Open on row selection" VerticalAlignment="Center"/><TextBlock x:Name="ReviewText" Margin="15,0,0,0" VerticalAlignment="Center"/></WrapPanel>
      <TextBlock x:Name="CountsText" Margin="0,0,0,6" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="OpenButton" Content="Open in Revit" Click="OpenClicked" Margin="0,0,6,0"/><Button x:Name="PreviousButton" Content="Previous" Click="PreviousClicked" Margin="0,0,6,0"/><Button x:Name="NextButton" Content="Next" Click="NextClicked" Margin="0,0,12,0"/><Button Content="Select all filtered" Click="SelectAllClicked" Margin="0,0,6,0"/><Button Content="Clear selection" Click="ClearSelectionClicked" Margin="0,0,6,0"/><Button Content="Preview selected" Click="PreviewClicked" Margin="0,0,6,0"/><Button Content="Recover from picked linked element" Click="RecoverClicked" Margin="0,0,6,0"/><Button Content="Export sanitized diagnostic" Click="ExportDiagnosticClicked" Margin="0,0,6,0"/><Button Content="Import / update valid preview" Click="ImportClicked" Margin="0,0,6,0"/><Button Content="Close" Click="CloseClicked"/></StackPanel>
    <DataGrid x:Name="IssueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow" IsSynchronizedWithCurrentItem="False" MouseDoubleClick="IssueDoubleClicked" SelectionChanged="IssueSelectionChanged" Margin="0,4,0,0"><DataGrid.Columns><DataGridTextColumn Header="Display ID" Binding="{Binding Issue.DisplayId}" Width="75"/><DataGridTextColumn Header="Title" Binding="{Binding Issue.Title}" Width="220"/><DataGridTextColumn Header="Status" Binding="{Binding Issue.Status}" Width="100"/><DataGridTextColumn Header="Type" Binding="{Binding Issue.Type}" Width="110"/><DataGridTextColumn Header="Assigned" Binding="{Binding Issue.AssignedUserName}" Width="130"/><DataGridTextColumn Header="Model" Binding="{Binding Issue.ModelUrn}" Width="180"/><DataGridTextColumn Header="Version" Binding="{Binding Issue.VersionUrn}" Width="180"/><DataGridTextColumn Header="Open" Binding="{Binding OpenStatus}" Width="200"/><DataGridTextColumn Header="Primary" Binding="{Binding PrimaryElementStatus}" Width="100"/><DataGridTextColumn Header="Secondary" Binding="{Binding SecondaryElementStatus}" Width="100"/><DataGridTextColumn Header="Section Box" Binding="{Binding SectionBoxStatus}" Width="120"/><DataGridTextColumn Header="Import" Binding="{Binding ImportStatus}" Width="100"/><DataGridTextColumn Header="Warning" Binding="{Binding Warning}" Width="260"/><DataGridTextColumn Header="Pushpin" Binding="{Binding PinText}" Width="70"/><DataGridTextColumn Header="Quality" Binding="{Binding QualityText}" Width="140"/></DataGrid.Columns></DataGrid>
  </DockPanel>
</Window>
