<Window x:Class="BuildAI.AccIssueReturn.Revit.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="BuildAI ACC Issue Preview" Width="1100" Height="620" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Text="Preview does not modify the Revit model. Import is available only for rows that pass all validation checks." TextWrapping="Wrap" Margin="0,0,0,8"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button x:Name="ImportButton" Content="Import valid rows" Click="ImportClicked" IsEnabled="False" Margin="0,0,8,0"/><Button Content="Close" Click="CloseClicked"/></StackPanel>
    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Issue" Binding="{Binding Issue.Id}" Width="140"/><DataGridTextColumn Header="Model version source" Binding="{Binding ModelVersionSource}" Width="140"/><DataGridTextColumn Header="Element mapping source" Binding="{Binding ElementMappingSource}" Width="160"/><DataGridTextColumn Header="Coordinate source" Binding="{Binding CoordinateSource}" Width="180"/><DataGridTextColumn Header="Coordinate validation" Binding="{Binding CoordinateValidation}" Width="130"/><DataGridTextColumn Header="Quality" Binding="{Binding Coordinates.Quality}" Width="130"/><DataGridTextColumn Header="External element" Binding="{Binding Coordinates.ExternalIdMatched}" Width="110"/><DataGridTextColumn Header="Blocking reasons" Binding="{Binding BlockingReasonText}" Width="*"/><DataGridTextColumn Header="Version warning / recovery" Binding="{Binding Coordinates.Warning}" Width="260"/></DataGrid.Columns></DataGrid>
  </DockPanel>
</Window>
