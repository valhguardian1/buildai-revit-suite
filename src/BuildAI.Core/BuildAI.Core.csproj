<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0 so the SAME Core DLL is referenced by both the .NET 4.8
    plugins (Revit 2023/2024) and the .NET 8 plugins (Revit 2025+).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BuildAI.Core</AssemblyName>
    <RootNamespace>BuildAI.Core</RootNamespace>
    <Version>7.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- .resx embed automatically; Strings.he.resx becomes the 'he' satellite. -->

</Project>


